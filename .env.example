# =============================================================================
# Environment overrides. Copy to `.env` (gitignored) and edit.
#
# These sit ABOVE both YAML files in precedence and below explicit code
# arguments. Nesting uses a double underscore:
#
#   MCMOT__<SECTION>__<KEY>=<value>
#
# Unknown MCMOT__* keys are rejected at startup on purpose: a silently ignored
# typo in a threshold is a bug you find three weeks later on a wrong-name frame.
# =============================================================================

# --- Deployment profile ---------------------------------------------------
# MCMOT__ENV=dev

# --- Where the project root lives (only needed for non-editable installs) --
# MCMOT_PROJECT_ROOT=C:/Users/taxiI/Documents/Hamza_CV_Projects/MTMCT
# MCMOT_CONFIG_DIR=C:/Users/taxiI/Documents/Hamza_CV_Projects/MTMCT/config

# --- Logging -------------------------------------------------------------
# MCMOT__LOGGING__LEVEL=DEBUG
# MCMOT__LOGGING__CONSOLE_FORMAT=json

# --- Device --------------------------------------------------------------
# MCMOT__DEVICE__PREFER=cuda
# MCMOT__DEVICE__ALLOW_CPU_FALLBACK=false

# --- Thresholds most likely to be tuned per site -------------------------
# MCMOT__DETECTOR__CONF_THRESHOLD=0.4
# MCMOT__IDENTITY__TAU_ACCEPT=0.62
# MCMOT__IDENTITY__TAU_MARGIN=0.08

# --- API -----------------------------------------------------------------
# MCMOT__API__PORT=8000
